{
  "name": "mailroom",
  "version": "2.1.0",
  "description": "Self-hosted bulk mail sender for your own SMTP account",
  "type": "module",
  "bin": {
    "mailroom": "bin/mailroom.mjs"
  },
  "files": [
    "bin",
    "src",
    "public",
    "templates",
    "README.md"
  ],
  "scripts": {
    "start": "node src/gui.mjs",
    "gui": "node src/gui.mjs",
    "send": "node src/send.mjs",
    "check": "node scripts/check-syntax.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3"
  }
}

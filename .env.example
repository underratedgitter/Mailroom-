# Mailroom settings. The setup screen writes this file for you; these keys are
# here for reference, for Docker, or for scripted installs.

# SMTP server. Gmail: smtp.gmail.com, port 465 (implicit TLS).
# Ports 587 and 25 switch to STARTTLS automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# The mailbox Mailroom signs in as. For Gmail, SMTP_PASS must be a
# 16-character App Password, not the login password.
SMTP_USER=you@yourdomain.com
SMTP_PASS=replace-with-app-password

# What recipients see. Defaults to the mailbox address.
EMAIL_FROM="Your Name <you@yourdomain.com>"

# Optional
# SMTP_SECURE=true          # only to override the port rule
# MAILROOM_PASSWORD=...     # session password; required if not bound to loopback

# Optional HTTPS. Set both paths to PEM files to serve TLS and mark the
# session cookie Secure. A non-loopback bind over plain HTTP is refused.
# MAILROOM_TLS_CERT=/path/to/fullchain.pem
# MAILROOM_TLS_KEY=/path/to/privkey.pem

# Only for a trusted reverse proxy that terminates TLS: allow plain HTTP on a
# non-loopback interface. Prefer MAILROOM_TLS_CERT/KEY instead.
# MAILROOM_ALLOW_INSECURE=1
